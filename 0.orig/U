FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1 0 0); //2

boundaryField
{
    inletWater
    {
        type            fixedValue;
        value           uniform (1 0 0); //2
    }
    inletAir
    {
        type            fixedValue;
        value           uniform (1 0 0);  //2
    }
    outlet
    {
        type            outletPhaseMeanVelocity;
        alpha           alpha.water;
        Umean           1;  //2
	value           $internalField; 
    }
    bottom
    {
        type            slip;
    }
    top
    {
        type            pressureInletOutletVelocity;
        value           $internalField;                        //uniform (0 0 0);
    }
    cylinder
    {
        type            noSlip;
    }
    defaultFaces
    {
        type            empty;
    }

}

