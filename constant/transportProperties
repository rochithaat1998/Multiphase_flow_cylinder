FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (water air);

water
{
    transportModel  Newtonian;
    nu              0.005555;              //0.011;
    rho             1000;
}

air
{
    transportModel  Newtonian;
    nu              0.005555;                       //0.0071422857143;       //0.011;

    rho             10;
}

sigma           0.00;


