FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     interIsoFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         300;        //75;

deltaT          0.001;

writeControl    timeStep;

writeInterval   1000;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression on;

timeFormat      general;

timePrecision   6;

maxCo           0.6;

maxAlphaCo      0.5;

maxDeltaT       0.001;

functions
{
    forces1
	{
    type            forces;
    libs            (forces);
    patches         (cylinder);
    CofR			(0 0 0);
	} 
	
	 vorticity1
    {
        type            vorticity;
        libs            (fieldFunctionObjects);
        field           U;                // Velocity field to compute vorticity from
        result          vorticity;        // Name of the output vorticity field
        enabled         true;
        writeControl    timeStep;
        writeInterval   1000;                // Output every time step (adjust as needed) //1
    }

